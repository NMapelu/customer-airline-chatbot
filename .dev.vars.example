# Local server secrets, used by `npm run dev` and `npm run preview`. Copy to .dev.vars.
# In production, set each one with `npx wrangler secret put <NAME>`.
# Which AI models to use: openai (default) or google (Gemini). Fill in only that provider's key.
# After changing it, run `npm run ingest` with the same AI_PROVIDER in .env.ingest.
AI_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: another Gemini model for answers and checks (lib/ai/models.ts has the default).
GEMINI_MODEL=

# Supabase: Project Settings → Data API → Project URL (ends in .supabase.co, nothing after it),
# and Project Settings → API Keys → the anon / publishable key. Never the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: the test user that `npm run eval` signs in as. The web app ignores these.
# Create the user in the Supabase dashboard, fill in these two, then run `npm run dev-user`,
# which adds DEV_USER_TOTP_SECRET below. Never set these in Cloudflare.
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

# Optional: the agent test user, so `npm run eval` also runs the agent questions.
# Fill in these two, run `npm run invite-agent -- --test-user` (needs .env.ingest), then
# `npm run dev-user -- --agent`, which adds DEV_AGENT_TOTP_SECRET below. Never set these in Cloudflare.
DEV_AGENT_EMAIL=
DEV_AGENT_PASSWORD=

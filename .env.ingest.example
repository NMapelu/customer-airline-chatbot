# Copy to .env.ingest (gitignored) and fill in. Used only by `npm run ingest`, never by the web app.
# Supabase dashboard -> Project Settings -> API (or Data API) for the URL and the service_role key.
# The service_role key bypasses Row Level Security: keep it out of .env.local, .dev.vars and Cloudflare.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

{
  "name": "customer-airline-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "preview": "npm run check-env && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run check-env && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check-env": "node scripts/check-env-files.mjs",
    "check-corpus": "node scripts/check-corpus.mjs",
    "fetch-corpus": "node scripts/fetch-corpus.mjs docs/public",
    "ingest": "tsx scripts/ingest.ts",
    "dev-user": "tsx scripts/dev-user.ts",
    "invite-agent": "tsx scripts/invite-agent.ts",
    "deactivate-agent": "tsx scripts/deactivate-agent.ts",
    "eval": "tsx scripts/eval.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"tests/integration/*.test.ts\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.146",
    "@opennextjs/cloudflare": "^1.20.11",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "ai": "^7.0.127",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "^5",
    "unpdf": "1.8.1",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=22"
  }
}
